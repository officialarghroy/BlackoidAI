 const hero=Math.max(0,1-scrollY/innerHeight),cxp=W*(innerWidth<860?.5:(.62-.12*(1-hero)*0)),cyp=H*(innerWidth<860?.35:.46),R=Math.min(W,H)*(innerWidth<860?.42:.4)*(1+(1-hero)*.15)*(1+(core.focus>=0?.06:0));
 const al=.18+.5*hero+(core.seq>0?.35:0);ctx.clearRect(0,0,W,H);
 const P=nodes.map(n=>{let x=n.x*cosy+n.z*siny,z=-n.x*siny+n.z*cosy,y=n.y*cosx-z*sinx;z=n.y*sinx+z*cosx;const f=1/(1.9-z*.5);return{x:cxp+x*R*f,y:cyp+y*R*f,z,f}});
 const act=core.seq>0?(core.seq-1)/7:-1,tm=t/1000;
 ctx.lineWidth=DPR*.6;
 for(const [i,j,d] of edges){const a=P[i],b=P[j],dep=(a.z+b.z)/2+1,gi=nodes[i].g==core.focus||nodes[j].g==core.focus;
  let o=.05+.13*dep;if(gi)o=.5;
  const wave=act>=0?Math.max(0,1-Math.abs(((nodes[i].y+1)/2)-act)*4):0;o=Math.max(o,wave*.7);
  ctx.strokeStyle=`rgba(244,244,245,${o*al*(gi?1.6:1)})`;ctx.beginPath();ctx.moveTo(a.x,a.y);ctx.lineTo(b.x,b.y);ctx.stroke()}
 for(let i=0;i<N;i++){const p=P[i],n=nodes[i],dep=p.z+1,gi=n.g==core.focus,wave=act>=0?Math.max(0,1-Math.abs(((n.y+1)/2)-act)*4):0;
  const pulse=(Math.sin(tm*1.4+i*.7)+1)/2>.97?1:0;let s=(.9+dep*.7)*DPR*(gi||wave>.5||pulse?1.9:1);
  ctx.fillStyle=`rgba(244,244,245,${Math.min(1,(.25+dep*.3+(gi?.6:0)+wave*.6+pulse*.5)*al*1.4)})`;ctx.fillRect(p.x-s/2,p.y-s/2,s,s)}
 /* reticle ring */
 ctx.strokeStyle=`rgba(244,244,245,${.12*al*2})`;ctx.lineWidth=DPR;ctx.beginPath();ctx.arc(cxp,cyp,R*1.12,0,7);ctx.stroke();
 ctx.beginPath();for(let k=0;k<48;k++){const a=k/48*Math.PI*2+rot*.5;ctx.moveTo(cxp+Math.cos(a)*R*1.12,cyp+Math.sin(a)*R*1.12);ctx.lineTo(cxp+Math.cos(a)*R*(k%6?1.14:1.18),cyp+Math.sin(a)*R*(k%6?1.14:1.18))}ctx.stroke()}
requestAnimationFrame(frame);

/* scroll: header, sequence */
const seqEl=$('#systems'),stgs=$$('#stg div'),sb=$('#sb'),sd=$('#sd'),sn=$('#sn'),pb=$('#pb');let last=-1;
function onS(){hd.classList.toggle('s',scrollY>30);
 const r=seqEl.getBoundingClientRect(),tot=r.height-innerHeight,pr=Math.min(1,Math.max(0,-r.top/tot));
 if(r.top<innerHeight&&r.bottom>0&&-r.top>-innerHeight*.3){const inside=r.top<=0&&r.bottom>=innerHeight;const idx=inside?Math.min(7,Math.floor(pr*8)):(r.top>0?-1:7);
  core.seq=inside?idx+1:0;pb.style.width=(pr*100)+'%';
  if(idx!==last&&idx>=0){last=idx;sb.style.opacity=0;setTimeout(()=>{sb.textContent=SEQ[idx][0];sd.textContent=SEQ[idx][1];sn.textContent=`Step 0${idx+1} / 08`;sb.style.opacity=1},RM?0:140);stgs.forEach((s,i)=>s.className=i==idx?'a':i<idx?'p':'')}}else core.seq=0}
addEventListener('scroll',onS,{passive:true});onS();

/* loader */
const ld=$('#ld');requestAnimationFrame(()=>ld.querySelector('.ln i').style.width='100%');
setTimeout(()=>$('#ldt').textContent='Almost there',450);
setTimeout(()=>$('#ldt').textContent='Ready',950);
setTimeout(()=>{ld.classList.add('x');document.body.classList.add('ready');setTimeout(()=>ld.remove(),1000)},RM?100:1250);
showCap(0);core.focus=-1;

/* legal dialogs */
const LG={privacy:$('#d-privacy'),terms:$('#d-terms')};
function legal(){const h=location.hash.slice(1);Object.entries(LG).forEach(([k,d])=>{if(k===h&&!d.open&&d.showModal)d.showModal();else if(k!==h&&d.open)d.close()})}
addEventListener('hashchange',legal);legal();
Object.values(LG).forEach(d=>{d.addEventListener('close',()=>{if(['#privacy','#terms'].includes(location.hash))history.replaceState(null,'',location.pathname+location.search)});d.addEventListener('click',e=>{if(e.target===d)d.close()})});
</script>
